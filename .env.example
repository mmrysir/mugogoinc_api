# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=production
APP_SECRET_KEY=change-me-to-a-random-64-char-string

# ── Database (PostgreSQL with asyncpg) ──────────────────────────────────────────
# PostgreSQL Production Connection URL:
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/mugogo_db

# SQLite local fallback:
# DATABASE_URL=sqlite+aiosqlite:///./mugogo_engine.db

# ── HMAC & Cloudflare Security ─────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=change-me-to-a-random-32-char-string
CLOUDFLARE_WORKER_SECRET=mgg_cf_worker_live_secret_key_2026

# ── Token Encryption (Fernet AES-128-CBC) ─────────────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# ── Subdirectory Blog Hub & Revalidation ─────────────────────────────────────
BLOG_SERVICE_TOKEN=mugogo-blog-internal-secret-token
NEXTJS_REVALIDATE_URL=https://www.biztali.com/api/revalidate
NEXTJS_REVALIDATE_SECRET=revalidate-secret-token

# ── Meta CAPI & Marketing APIs ───────────────────────────────────────────────
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=  # Required only if using an MCC Manager Account
GOOGLE_ADS_CONVERSION_ACTION_ID=
CPL_THRESHOLD_USD=15.0

# ── WhatsApp Cloud API ─────────────────────────────────────────────────────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_API_VERSION=v20.0

# ── Resend (Transactional Email) ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@mugogoinc.com

# ── CORS ───────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://engine.mugogoinc.com,http://localhost:3000,http://localhost:3002,http://localhost:5173
