# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-random-64-char-string

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite (default for local dev)
DATABASE_URL=sqlite+aiosqlite:///./mugogo_engine.db

# PostgreSQL (uncomment when migrating via Alembic)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/mugogo_engine

# ── WhatsApp Cloud API ─────────────────────────────────────────────────────────
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_API_VERSION=v20.0

# ── Resend (Transactional Email) ───────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@mugogoinc.com

# ── HMAC Webhook Signing ───────────────────────────────────────────────────────
WEBHOOK_SIGNING_SECRET=change-me-to-a-random-32-char-string

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
