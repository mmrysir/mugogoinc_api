{
  "info": {
    "name": "Mugogo API",
    "_postman_id": "mugogo-api-collection",
    "description": "Collection to exercise Mugogo Inc. API (health, auth, ingest, orgs, leads)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/"
      }
    },
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"name\": \"Test User\",\n  \"password\": \"secret123\"\n}"
        },
        "url": "{{base_url}}/api/v1/auth/register"
      }
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"secret123\"\n}"
        },
        "url": "{{base_url}}/api/v1/auth/login"
      }
    },
    {
      "name": "Me (requires token)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": "{{base_url}}/api/v1/auth/me"
      }
    },
    {
      "name": "Create Organization",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Test Org\"\n}"
        },
        "url": "{{base_url}}/api/v1/organizations"
      }
    },
    {
      "name": "List Organizations",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/organizations"
      }
    },
    {
      "name": "Ingest Lead (example)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"source_channel\": \"LANDING_PAGE\",\n  \"full_name\": \"Jane Doe\",\n  \"phone_number\": \"+254712345678\",\n  \"email\": \"jane@example.com\",\n  \"payload_meta\": {}\n}"
        },
        "url": "{{base_url}}/api/v1/ingest/{{business_unit_id}}"
      }
    },
    {
      "name": "List Leads",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/leads"
      }
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "business_unit_id", "value": "" }
  ]
}
